# RouteLink Environment Variables Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# Flask Security
# IMPORTANT: Change this to a random secure string in production!
SECRET_KEY=your-secret-key-change-in-production

# AI API Configuration (Optional - app works without AI)
# Get your API key from https://platform.openai.com or other providers
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo

# Application URL for QR code generation
APP_URL=http://localhost:5000

# OSRM Routing Server (using public demo server)
# For production, set up your own OSRM instance
OSRM_SERVER=http://router.project-osrm.org/route/v1

# Nominatim Geocoding Server (OpenStreetMap)
NOMINATIM_SERVER=https://nominatim.openstreetmap.org

# Location Update Interval (seconds)
LOCATION_UPDATE_INTERVAL=5
